# EditorConfig para Biblia Universal de IA
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# TypeScript/JavaScript/JSON
[*.{ts,tsx,js,jsx,json,md}]
indent_size = 2
quote_type = single
max_line_length = 100

# Python
[*.py]
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = 0

# CSS/SCSS
[*.{css,scss,sass}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Prisma
[*.prisma]
indent_size = 2

# Git
[.gitignore]
indent_size = 2

# EditorConfig
[.editorconfig]
indent_size = 2